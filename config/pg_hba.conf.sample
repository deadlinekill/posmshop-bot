# Правила аутентификации (листинг 4 отчёта).
# Суперпользователь postgres входит только локально (peer),
# приложения только из внутренней сети, только по SSL и только по scram-sha-256.
# Последняя строка запрещает всё, что не разрешено выше.

# TYPE   DATABASE  USER           ADDRESS       METHOD
local    all       postgres                     peer
hostssl  posmshop  bot_app        10.10.0.0/24  scram-sha-256
hostssl  posmshop  manager_app    10.10.0.0/24  scram-sha-256
hostssl  posmshop  report_reader  10.10.0.0/24  scram-sha-256
host     posmshop  backup_agent   127.0.0.1/32  scram-sha-256
host     all       all            0.0.0.0/0     reject

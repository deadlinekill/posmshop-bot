# Токен бота
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Подключение к PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=posmshop
# disable / prefer / require / verify-full
DB_SSLMODE=prefer

# Пароли ролей (случайные, не короче 24 символов)
BOT_DB_PASSWORD=
MANAGER_DB_PASSWORD=
REPORT_DB_PASSWORD=
BACKUP_DB_PASSWORD=

# Ключ шифрования телефонов (pgcrypto).
PHONE_KEY=

# Только для scripts/setup_db.py: подключение суперпользователя
ADMIN_DSN=postgresql://postgres:PASSWORD@127.0.0.1:5432/postgres

# Только для тестов: отдельная база posmshop_test создаётся и удаляется сама
TEST_ADMIN_DSN=postgresql://postgres:PASSWORD@127.0.0.1:5432/postgres
